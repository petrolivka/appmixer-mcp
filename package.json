{
    "name": "appmixer-mcp",
    "version": "2.0.0",
    "description": "MCP server for Appmixer — control, observe and (soon) build Appmixer flows from any MCP client.",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "appmixer-mcp": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "gen:guide": "node scripts/gen-guide.mjs",
        "dev": "tsx src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build && npm test"
    },
    "homepage": "https://github.com/Appmixer-ai/appmixer-mcp",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Appmixer-ai/appmixer-mcp.git"
    },
    "bugs": "https://github.com/Appmixer-ai/appmixer-mcp/issues",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "appmixer",
        "automation",
        "workflow"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "eventsource": "^3.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vitest": "^4.1.10"
    }
}
